          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="rnote" value="⚠ Revocation is immediate for new API requests&#xa;⚠ Presigned URLs already issued still work until expiry (5 min)&#xa;⚠ Grantee's sync picks up 'unshare' → removes node locally" style="text;html=1;fontSize=10;fontStyle=2;align=left;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
