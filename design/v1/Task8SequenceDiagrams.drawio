<mxfile host="app.diagrams.net">

  <!-- ==================== PAGE 1: AUTH (Signup + Login) ==================== -->
  <diagram id="auth" name="1. Auth Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Auth Flow — Signup &amp; Login" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p1" value="&lt;b&gt;Client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;API Server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="50" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="90" as="sourcePoint" /><mxPoint x="140" y="880" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="90" as="sourcePoint" /><mxPoint x="440" y="880" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="90" as="sourcePoint" /><mxPoint x="740" y="880" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- SIGNUP Section -->
        <mxCell id="s0" value="SIGNUP" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="80" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s1" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="150" as="sourcePoint" /><mxPoint x="440" y="150" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s1l" value="POST /auth/signup { email, password }" style="edgeLabel;html=1;fontSize=10;align=center;" vertex="1" connectable="0" parent="s1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s2" value="Validate email format, password ≥ 8 chars" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="165" width="200" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s3" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="205" as="sourcePoint" /><mxPoint x="740" y="205" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s3l" value="SELECT ... WHERE email = ?" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s4" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="230" as="sourcePoint" /><mxPoint x="440" y="230" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s4l" value="email not taken ✓" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s5" value="hash = bcrypt(password, cost=12)" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="245" width="180" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s6" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="285" as="sourcePoint" /><mxPoint x="740" y="285" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s6l" value="INSERT INTO users (email, password_hash)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s6">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s7" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="310" as="sourcePoint" /><mxPoint x="440" y="310" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s7l" value="user_id" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s7">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s8" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="340" as="sourcePoint" /><mxPoint x="140" y="340" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s8l" value="201 { user_id, email }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s8">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Divider -->
        <mxCell id="div1" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="20" y="380" as="sourcePoint" /><mxPoint x="860" y="380" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- LOGIN Section -->
        <mxCell id="lg0" value="LOGIN" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="395" width="80" height="25" as="geometry" />
        </mxCell>

        <mxCell id="lg1" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="440" as="sourcePoint" /><mxPoint x="440" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg1l" value="POST /auth/login { email, password }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="lg1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="lg2" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="470" as="sourcePoint" /><mxPoint x="740" y="470" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg2l" value="SELECT id, password_hash WHERE email = ?" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="lg2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="lg3" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="495" as="sourcePoint" /><mxPoint x="440" y="495" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg3l" value="user row" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="lg3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="lg4" value="bcrypt.Compare(password, hash)" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="510" width="180" height="25" as="geometry" />
        </mxCell>

        <mxCell id="lg5" value="Generate JWT (sub, email, exp, jti)&#xa;Generate refresh_token (random 32 bytes)" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="545" width="220" height="40" as="geometry" />
        </mxCell>

        <mxCell id="lg6" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="600" as="sourcePoint" /><mxPoint x="740" y="600" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg6l" value="INSERT INTO refresh_tokens (user_id, token_hash, expires_at)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="lg6">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="lg7" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="625" as="sourcePoint" /><mxPoint x="440" y="625" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg7l" value="stored ✓" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="lg7">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="lg8" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="660" as="sourcePoint" /><mxPoint x="140" y="660" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg8l" value="200 { access_token, refresh_token, expires_in: 900 }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="lg8">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Divider -->
        <mxCell id="div2" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="20" y="700" as="sourcePoint" /><mxPoint x="860" y="700" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- REFRESH Section -->
        <mxCell id="rf0" value="REFRESH" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="715" width="80" height="25" as="geometry" />
        </mxCell>

        <mxCell id="rf1" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="755" as="sourcePoint" /><mxPoint x="440" y="755" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="rf1l" value="POST /auth/refresh { refresh_token }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="rf1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="rf2" value="hash = SHA-256(refresh_token)" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="768" width="180" height="25" as="geometry" />
        </mxCell>

        <mxCell id="rf3" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="808" as="sourcePoint" /><mxPoint x="740" y="808" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="rf3l" value="SELECT user_id WHERE token_hash = ? AND expires_at > now()" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="rf3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="rf4" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="833" as="sourcePoint" /><mxPoint x="440" y="833" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="rf4l" value="user_id" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="rf4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="rf5" value="Generate new JWT" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="845" width="140" height="20" as="geometry" />
        </mxCell>

        <mxCell id="rf6" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="878" as="sourcePoint" /><mxPoint x="140" y="878" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="rf6l" value="200 { access_token, expires_in: 900 }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="rf6">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ==================== PAGE 2: CHUNKED UPLOAD ==================== -->
  <diagram id="upload" name="2. Chunked Upload">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Chunked Upload Flow — Init → Upload → Commit" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p1" value="&lt;b&gt;Client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;API Server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;S3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="50" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="90" as="sourcePoint" /><mxPoint x="120" y="1100" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="90" as="sourcePoint" /><mxPoint x="440" y="1100" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="90" as="sourcePoint" /><mxPoint x="740" y="1100" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l4" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="90" as="sourcePoint" /><mxPoint x="1040" y="1100" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- PHASE 1: Client-side prep -->
        <mxCell id="ph1" value="PHASE 1: CLIENT PREP" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="110" width="180" height="25" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="Split file into 4 MB chunks&#xa;Compute SHA-256 hash per chunk" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="145" width="180" height="35" as="geometry" />
        </mxCell>

        <!-- PHASE 2: Init upload -->
        <mxCell id="ph2" value="PHASE 2: INIT UPLOAD" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="200" width="180" height="25" as="geometry" />
        </mxCell>

        <mxCell id="u1" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="245" as="sourcePoint" /><mxPoint x="440" y="245" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="u1l" value="POST /files { parent_id, name, size, chunk_hashes[] }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="u1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="u2" value="Auth middleware → verify JWT → get user_id" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="335" y="258" width="210" height="22" as="geometry" />
        </mxCell>

        <mxCell id="u3" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="295" as="sourcePoint" /><mxPoint x="740" y="295" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="u3l" value="Check ACL on parent_id, check name unique" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="u3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="u4" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="325" as="sourcePoint" /><mxPoint x="740" y="325" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="u4l" value="Check which chunk_hashes already exist in chunks table" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="u4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="u5" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="350" as="sourcePoint" /><mxPoint x="440" y="350" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="u5l" value="existing hashes list" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="u5">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="u6" value="Generate presigned PUT URLs for&#xa;missing chunks only (dedup skip)" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="365" width="220" height="35" as="geometry" />
        </mxCell>

        <mxCell id="u7" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="415" as="sourcePoint" /><mxPoint x="740" y="415" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="u7l" value="INSERT node (status=uploading), version row" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="u7">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="u8" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="450" as="sourcePoint" /><mxPoint x="120" y="450" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="u8l" value="201 { file_id, upload_id, chunks[ { index, hash, presigned_url, already_exists } ] }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="u8">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- PHASE 3: Upload chunks -->
        <mxCell id="ph3" value="PHASE 3: UPLOAD CHUNKS (parallel, direct to S3)" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="490" width="340" height="25" as="geometry" />
        </mxCell>

        <mxCell id="cu1" style="endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="535" as="sourcePoint" /><mxPoint x="1040" y="535" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cu1l" value="PUT chunk 0 → presigned URL (4 MB)" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="cu1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cu2" style="endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="565" as="sourcePoint" /><mxPoint x="1040" y="565" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cu2l" value="PUT chunk 1 → presigned URL (4 MB)" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="cu2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cu3" style="endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="595" as="sourcePoint" /><mxPoint x="1040" y="595" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cu3l" value="PUT chunk N → presigned URL (remaining bytes)" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="cu3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cu1r" style="endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="630" as="sourcePoint" /><mxPoint x="120" y="630" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cu1rl" value="200 OK (per chunk, ETag returned)" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="cu1r">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cunote" value="⚠ Chunks skip already_exists=true&#xa;⚠ Client retries failed PUTs (idempotent)&#xa;⚠ API is NOT in this data path" style="text;html=1;fontSize=10;fontStyle=2;align=left;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="650" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- PHASE 4: Commit -->
        <mxCell id="ph4" value="PHASE 4: COMMIT" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="720" width="150" height="25" as="geometry" />
        </mxCell>

        <mxCell id="cm1" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="765" as="sourcePoint" /><mxPoint x="440" y="765" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cm1l" value="POST /files/{file_id}/commit { upload_id }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="cm1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cm2" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="795" as="sourcePoint" /><mxPoint x="1040" y="795" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cm2l" value="HEAD each chunk key → verify exists in S3" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="cm2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cm3" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="820" as="sourcePoint" /><mxPoint x="440" y="820" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cm3l" value="all chunks present ✓" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="cm3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cm4" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="850" as="sourcePoint" /><mxPoint x="740" y="850" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cm4l" value="BEGIN: INSERT chunks, version_chunks, UPDATE version status=committed,&#xa;UPDATE node current_version_id, INSERT change_log" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="cm4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cm5" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="890" as="sourcePoint" /><mxPoint x="440" y="890" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cm5l" value="COMMIT ✓" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="cm5">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cm6" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="920" as="sourcePoint" /><mxPoint x="120" y="920" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cm6l" value="200 { file_id, version_id, name, size }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="cm6">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="cmnote" value="File is now COMMITTED — visible in sync, downloadable, shareable" style="text;html=1;fontSize=10;fontStyle=6;align=center;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="945" width="400" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ==================== PAGE 3: DOWNLOAD ==================== -->
  <diagram id="download" name="3. Download">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Download Flow" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p1" value="&lt;b&gt;Client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;API Server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;S3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="50" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="90" as="sourcePoint" /><mxPoint x="120" y="700" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="90" as="sourcePoint" /><mxPoint x="440" y="700" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="90" as="sourcePoint" /><mxPoint x="740" y="700" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l4" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="90" as="sourcePoint" /><mxPoint x="1040" y="700" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Request -->
        <mxCell id="d1" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="130" as="sourcePoint" /><mxPoint x="440" y="130" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="d1l" value="GET /files/{file_id}/download ?version_id=optional" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="d1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="d2" value="Auth middleware → verify JWT" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="143" width="180" height="22" as="geometry" />
        </mxCell>

        <!-- ACL check -->
        <mxCell id="d3" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="180" as="sourcePoint" /><mxPoint x="740" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="d3l" value="Check permission (owner / editor / viewer)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="d3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="d4" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="205" as="sourcePoint" /><mxPoint x="440" y="205" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="d4l" value="permitted ✓" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="d4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Get chunk list -->
        <mxCell id="d5" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="235" as="sourcePoint" /><mxPoint x="740" y="235" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="d5l" value="SELECT chunk_hash, chunk_index, s3_key&#xa;FROM version_chunks JOIN chunks" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="d5">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="d6" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="270" as="sourcePoint" /><mxPoint x="440" y="270" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="d6l" value="ordered chunk list" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="d6">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Generate presigned GETs -->
        <mxCell id="d7" value="Generate presigned GET URLs for each chunk (5 min expiry)" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="285" width="260" height="25" as="geometry" />
        </mxCell>

        <!-- Return to client -->
        <mxCell id="d8" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="330" as="sourcePoint" /><mxPoint x="120" y="330" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="d8l" value="200 { file_id, version_id, chunks[ { index, hash, presigned_url } ] }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="d8">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Divider -->
        <mxCell id="div1" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="20" y="370" as="sourcePoint" /><mxPoint x="1150" y="370" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Download chunks -->
        <mxCell id="ph2" value="CLIENT DOWNLOADS (parallel, direct from S3)" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="390" width="330" height="25" as="geometry" />
        </mxCell>

        <mxCell id="dl1" style="endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="435" as="sourcePoint" /><mxPoint x="1040" y="435" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dl1l" value="GET chunk 0 → presigned URL" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="dl1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="dl2" style="endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="465" as="sourcePoint" /><mxPoint x="1040" y="465" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dl2l" value="GET chunk 1 → presigned URL" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="dl2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="dl3" style="endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="495" as="sourcePoint" /><mxPoint x="1040" y="495" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dl3l" value="GET chunk N → presigned URL" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="dl3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="dlr" style="endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="530" as="sourcePoint" /><mxPoint x="120" y="530" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dlrl" value="chunk bytes (per chunk)" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;" vertex="1" connectable="0" parent="dlr">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Client reassembly -->
        <mxCell id="asm" value="Client verifies SHA-256 of each chunk&#xa;Reassembles file in index order&#xa;Writes to local disk" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="200" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ==================== PAGE 4: SYNC POLLING ==================== -->
  <diagram id="sync" name="4. Sync Polling">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sync Polling Flow" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p1" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;(sync daemon)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;API Server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="50" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="90" as="sourcePoint" /><mxPoint x="120" y="820" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="90" as="sourcePoint" /><mxPoint x="440" y="820" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="90" as="sourcePoint" /><mxPoint x="740" y="820" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Initial sync (cursor=0) -->
        <mxCell id="is0" value="INITIAL SYNC (first time)" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="110" width="200" height="25" as="geometry" />
        </mxCell>

        <mxCell id="is1" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="155" as="sourcePoint" /><mxPoint x="440" y="155" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="is1l" value="GET /changes?cursor=0&amp;limit=100" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="is1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="is2" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="185" as="sourcePoint" /><mxPoint x="740" y="185" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="is2l" value="SELECT * FROM change_log&#xa;WHERE user_id=$1 AND seq &gt; 0 ORDER BY seq LIMIT 100" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="is2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="is3" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="220" as="sourcePoint" /><mxPoint x="440" y="220" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="is3l" value="rows (all changes since beginning)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="is3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="is4" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="250" as="sourcePoint" /><mxPoint x="120" y="250" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="is4l" value="200 { changes[ ... ], next_cursor: 1050, has_more: true }" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="is4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="is5" value="Apply changes to local file tree&#xa;Store next_cursor = 1050" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="265" width="180" height="35" as="geometry" />
        </mxCell>

        <mxCell id="is6" value="If has_more=true, immediately&#xa;fetch next page (don't wait 10s)" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="180" height="35" as="geometry" />
        </mxCell>

        <!-- Divider -->
        <mxCell id="div1" style="endArrow=none;dashed=1;strokeColor=#CCCCCC;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="20" y="370" as="sourcePoint" /><mxPoint x="860" y="370" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Steady state polling -->
        <mxCell id="ss0" value="STEADY STATE (every 10 seconds)" style="text;html=1;fontSize=13;fontStyle=5;align=left;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="390" width="250" height="25" as="geometry" />
        </mxCell>

        <mxCell id="ss1" value="⏱ wait 10 seconds" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#f5f5f5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="425" width="120" height="22" as="geometry" />
        </mxCell>

        <mxCell id="ss2" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="465" as="sourcePoint" /><mxPoint x="440" y="465" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="ss2l" value="GET /changes?cursor=1050&amp;limit=100" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ss2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="ss3" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="495" as="sourcePoint" /><mxPoint x="740" y="495" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="ss3l" value="SELECT ... WHERE user_id=$1 AND seq &gt; 1050 LIMIT 100" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ss3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="ss4" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="740" y="520" as="sourcePoint" /><mxPoint x="440" y="520" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="ss4l" value="3 new changes" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ss4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

