        <mxCell id="gnote" value="Grantee's sync client picks up the 'share' event&#xa;on the next poll → discovers new shared node" style="text;html=1;fontSize=10;fontStyle=2;align=center;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
