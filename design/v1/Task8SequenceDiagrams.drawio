        </mxCell>
        <mxCell id="r4l" value="BEGIN: DELETE FROM shares + INSERT INTO change_log&#xa;(user_id=grantee, op='unshare') COMMIT" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="r4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="r5" style="endArrow=open;endFill=0;dashed=1;strokeColor=#333333;" edge="1" parent="1">
